# Impact Radar — environment variables template
#
# Copy this file to `.env` and edit values to taste. `src/api/main.py`,
# `scripts/learn.py`, and `scripts/build_embeddings.py` all call
# `python-dotenv`'s `load_dotenv()` at startup, so anything you put
# here shows up in `os.environ` automatically.
#
# Everything NOT listed here lives in `config/model_config.yaml` — the
# RAG tuning knobs (chunk size, top-k, embedding provider, etc.),
# language support, security/privacy redaction, and cost estimation
# all belong in the YAML. This file is only for runtime secrets and
# quickstart toggles.

# OpenAI API key — required for:
#   - `embed=true` on POST /api/v2/ingest
#   - `use_llm=true` on POST /api/v1/analyze
#   - scripts/build_embeddings.py
#
# Not required for seed-data V1 analyze (LLM is optional) or local-only
# mode (set `security.privacy.local_only_mode: true` in the YAML).
# OPENAI_API_KEY=sk-...

# Set to 1 to enable the RAG-pipeline narrator. When enabled, the
# server and scripts emit short "why we do this" explainers at key
# pipeline events (startup, ingest, embedding, gap detection, compile,
# analyze). Silent no-op when unset — zero runtime cost.
# LEARNING_MODE=1
